@model SmartWare.Application.Catalog.Suppliers.SupplierDetails
@{ ViewData["Title"] = "Chi tiết nhà cung cấp"; }
<div class="form-page form-page-wide">
    <div class="form-page-header"><div><span class="eyebrow">@Model.Code</span><h1>@Model.Name</h1><p>Hồ sơ và số liệu giao dịch của nhà cung cấp.</p></div><div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Chỉnh sửa</a><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></div>
    <section class="panel detail-card">
        <dl class="detail-grid">
            <div><dt>Trạng thái</dt><dd><span class="state-badge @(Model.IsActive ? "state-active" : "state-inactive")">@(Model.IsActive ? "Hoạt động" : "Ngừng hoạt động")</span></dd></div>
            <div><dt>Người liên hệ</dt><dd>@(Model.ContactName ?? "—")</dd></div>
            <div><dt>Số điện thoại</dt><dd>@(Model.Phone ?? "—")</dd></div>
            <div><dt>Email</dt><dd>@(Model.Email ?? "—")</dd></div>
            <div><dt>Số sản phẩm</dt><dd>@Model.ProductCount.ToString("N0")</dd></div>
            <div><dt>Số phiếu nhập</dt><dd>@Model.ReceiptCount.ToString("N0")</dd></div>
            <div><dt>Giá trị nhập hoàn tất</dt><dd>@Model.TotalImportedValue.ToString("N0") ₫</dd></div>
            <div><dt>Ngày tạo</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
            <div class="detail-wide"><dt>Địa chỉ</dt><dd>@(Model.Address ?? "—")</dd></div>
        </dl>
    </section>
</div>
