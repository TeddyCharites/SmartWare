@model SmartWare.Application.Catalog.Products.ProductDetails
@{ ViewData["Title"] = "Chi tiết sản phẩm"; var isLow = Model.AvailableQuantity <= Model.MinimumStock; }
<div class="form-page form-page-wide">
    <div class="form-page-header"><div><span class="eyebrow">@Model.Sku</span><h1>@Model.Name</h1><p>@Model.CategoryName · @Model.SupplierName</p></div><div class="d-flex gap-2">@if (User.IsInRole(RoleNames.Admin)) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Chỉnh sửa</a> }<a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></div>
    <section class="product-detail-summary panel">
        <div class="product-detail-identity">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="Ảnh @Model.Name" /> } else { <span>@Model.Name[..1].ToUpperInvariant()</span> }
            <div><span class="state-badge @(Model.IsActive ? "state-active" : "state-inactive")">@(Model.IsActive ? "Đang kinh doanh" : "Ngừng kinh doanh")</span><p>@(Model.Description ?? "Chưa có mô tả cho sản phẩm này.")</p></div>
        </div>
        <div class="inventory-summary">
            <div><span>Tồn thực tế</span><strong>@Model.CurrentQuantity.ToString("N0")</strong></div>
            <div><span>Đã giữ</span><strong>@Model.ReservedQuantity.ToString("N0")</strong></div>
            <div><span>Khả dụng</span><strong class="@(isLow ? "text-warning-emphasis" : "")">@Model.AvailableQuantity.ToString("N0")</strong></div>
        </div>
    </section>
    <section class="panel detail-card mt-3"><dl class="detail-grid">
        <div><dt>Danh mục</dt><dd>@Model.CategoryName</dd></div><div><dt>Nhà cung cấp</dt><dd>@Model.SupplierName</dd></div>
        <div><dt>Đơn vị tính</dt><dd>@Model.UnitOfMeasure</dd></div><div><dt>Giá bán</dt><dd>@Model.SellingPrice.ToString("N0") ₫</dd></div>
        <div><dt>Giá vốn bình quân</dt><dd>@Model.AverageCost.ToString("N0") ₫</dd></div><div><dt>Ngưỡng tồn</dt><dd>@Model.MinimumStock.ToString("N0") — @Model.MaximumStock.ToString("N0")</dd></div>
        <div><dt>Ngày tạo</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Cập nhật cuối</dt><dd>@(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd></div>
    </dl></section>
</div>
