@model IReadOnlyList<SmartWare.Application.Identity.UserSummary>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Quản lý người dùng</h1>
        <p class="text-secondary mb-0">Quản lý tài khoản, trạng thái và vai trò hệ thống.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm người dùng</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">Chưa có người dùng.</td></tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@(user.PhoneNumber ?? "—")</td>
                            <td>
                                @(user.Role == RoleNames.Manager ? "Quản lý" :
                                  user.Role == RoleNames.Employee ? "Nhân viên" : user.Role)
                            </td>
                            <td>
                                @if (user.Status == UserStatus.Active)
                                {
                                    <span class="badge text-bg-success">Hoạt động</span>
                                }
                                else if (user.Status == UserStatus.Locked)
                                {
                                    <span class="badge text-bg-warning">Đã khóa</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Ngừng hoạt động</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Chỉnh sửa</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
