@model SmartWare.Web.ViewModels.Customers.CustomerFormViewModel
@{ ViewData["Title"] = "Chỉnh sửa khách hàng"; }
<div class="form-page form-page-wide">
    <div class="form-page-header"><div><span class="eyebrow">@Model.Code</span><h1>Chỉnh sửa khách hàng</h1><p>Cập nhật thông tin liên hệ và trạng thái hoạt động.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
    <form method="post" class="panel form-panel"><div class="panel-body"><partial name="_Form" model="Model" /></div><div class="form-actions"><a asp-action="Index" class="btn btn-light">Hủy</a><button type="submit" class="btn btn-primary">Lưu thay đổi</button></div></form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
